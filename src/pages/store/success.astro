---
import Layout from '../../layouts/Layout.astro';
import {
  getVerifiedPurchase,
  isCheckoutSessionId,
} from '../../lib/storefront/server';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const sessionId = Astro.url.searchParams.get('session_id');
const accessToken = Astro.url.searchParams.get('access_token');
let purchase: Awaited<ReturnType<typeof getVerifiedPurchase>> | undefined;
let unavailable = false;

if (isCheckoutSessionId(sessionId)) {
  try {
    purchase = await getVerifiedPurchase(sessionId, accessToken);
  } catch {
    unavailable = true;
  }
}

const product = purchase?.eligible ? purchase.product : undefined;
const purchaseParams = new URLSearchParams();
if (sessionId) purchaseParams.set('session_id', sessionId);
if (accessToken) purchaseParams.set('access_token', accessToken);
const downloadUrl =
  product && sessionId ? `/store/download?${purchaseParams}` : undefined;
const reason = purchase && !purchase.eligible ? purchase.reason : undefined;
const retryUrl = isCheckoutSessionId(sessionId)
  ? `/store/success?${purchaseParams}`
  : undefined;
const accessExpiresAt = purchase?.eligible
  ? new Date(purchase.accessExpiresAt * 1000)
  : undefined;
const expiryLabel = accessExpiresAt?.toLocaleString('en-US', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'UTC',
});
---

<Layout
  meta={{
    title: 'Test purchase status | Skin Schema',
    description: 'Your Skin Schema test purchase status and bundle download.',
    canonicalURL: '/store/success',
    robots: 'noindex, nofollow',
    analytics: false,
    themeColor: '#071310',
    statusBarStyle: 'black-translucent',
  }}
  mode="dark"
  hideFooter
>
  <main id="main" class="purchase-status">
    {
      product && downloadUrl ? (
        <>
          <h1>Test payment confirmed.</h1>
          <p>
            Your {product.name} bundle is ready: {product.clipCount} source
            videos,
            {product.downloadSize}.
          </p>
          <a class="purchase-status__button" href={downloadUrl}>
            Download {product.name}
          </a>
          <p class="purchase-status__note">
            {accessToken
              ? 'This replacement link expires on '
              : 'Your 24-hour download window ends on '}
            <time datetime={accessExpiresAt?.toISOString()}>
              {expiryLabel} UTC
            </time>
            . Each file link is valid for up to five minutes.
          </p>
          <p class="purchase-status__note">
            Need to download again later? Email{' '}
            <a href="mailto:glow@skinschema.com">glow@skinschema.com</a> from
            the email address you used at Checkout. We’ll verify your purchase
            and send a new timed link.
          </p>
          <p class="purchase-status__note">
            No real payment was taken. Commercial license terms are pending, and
            this test download grants no usage rights.
          </p>
        </>
      ) : unavailable ? (
        <>
          <h1>Purchase verification is unavailable.</h1>
          <p>
            We could not check your test payment with Stripe. Wait a moment,
            then check this page again.
          </p>
          <a class="purchase-status__button" href={retryUrl}>
            Check purchase status again
          </a>
        </>
      ) : reason === 'expired' ? (
        <>
          <h1>This download link has expired.</h1>
          <p>
            Email <a href="mailto:glow@skinschema.com">glow@skinschema.com</a>{' '}
            from the email address you used at Checkout. We’ll verify your
            purchase and send a new timed link.
          </p>
        </>
      ) : reason === 'unpaid' ? (
        <>
          <h1>Test payment is not confirmed yet.</h1>
          <p>
            Stripe has not confirmed a completed test payment. If you just
            finished Checkout, wait a moment and check again. Downloads become
            available after confirmation.
          </p>
          <a class="purchase-status__button" href={retryUrl}>
            Check purchase status again
          </a>
        </>
      ) : reason === 'fully-refunded' ? (
        <>
          <h1>This test payment was refunded.</h1>
          <p>
            The payment was fully refunded in Stripe, so this purchase no longer
            provides a bundle download. Start a new test Checkout to try the
            download flow again.
          </p>
        </>
      ) : reason === 'disputed' ? (
        <>
          <h1>This test payment is disputed.</h1>
          <p>
            Stripe reports a dispute for this payment. The bundle download is
            unavailable while the payment is disputed.
          </p>
        </>
      ) : reason === 'wrong-price' ? (
        <>
          <h1>This test purchase does not match a bundle.</h1>
          <p>
            Stripe returned a payment for a different offer. Return to the
            preview store and start test Checkout for the bundle you want.
          </p>
        </>
      ) : reason === 'not-test-mode' ? (
        <>
          <h1>This store accepts test purchases only.</h1>
          <p>
            This purchase is outside the Stripe test flow. Return to the preview
            store to start a test Checkout.
          </p>
        </>
      ) : (
        <>
          <h1>This test purchase link is not valid.</h1>
          <p>
            If you already completed Checkout, email{' '}
            <a href="mailto:glow@skinschema.com">glow@skinschema.com</a> from
            the email address you used for your purchase. We’ll verify it and
            send a new timed link.
          </p>
        </>
      )
    }
    <a class="purchase-status__back" href="/store"
      >Return to the preview store</a
    >
  </main>
</Layout>

<style>
  .purchase-status {
    background: var(--color-surface-auxiliary-background-color);
    color: var(--color-surface-auxiliary-foreground-color);
    display: grid;
    gap: var(--spacing-m);
    min-block-size: 100vh;
    padding: var(--spacing-2xl) var(--spacing-s-l);
    place-content: center start;
  }

  .purchase-status h1 {
    font-size: var(--text-step-5);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
    max-inline-size: 17ch;
    text-wrap: balance;
  }

  .purchase-status p {
    font-size: var(--text-step-1);
    margin: 0;
    max-inline-size: 52ch;
  }

  .purchase-status .purchase-status__note {
    font-size: var(--text-step-0);
    max-inline-size: 65ch;
  }

  .purchase-status__button,
  .purchase-status__back {
    inline-size: fit-content;
    max-inline-size: 100%;
  }

  .purchase-status__button {
    background: var(--color-action-primary-background-color);
    border: 1px solid var(--color-action-primary-border-color);
    border-radius: 999px;
    color: var(--color-action-primary-foreground-color);
    font-family: var(--font-mono);
    font-size: var(--text-step-000);
    font-weight: var(--font-weight-bold);
    min-block-size: 44px;
    padding: var(--spacing-xs) var(--spacing-m);
    text-decoration: none;
  }

  .purchase-status__button:hover {
    filter: brightness(1.08);
  }

  .purchase-status__back {
    color: var(--color-action-auxiliary-foreground-color);
    margin-block-start: var(--spacing-s);
    text-underline-offset: 0.2em;
  }

  .purchase-status a:focus-visible {
    outline: 2px solid var(--color-surface-auxiliary-foreground-color);
    outline-offset: 0.25rem;
  }
</style>
