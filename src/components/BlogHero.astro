---
import Header from './Header.astro';
const { title } = Astro.props;
---

<div>
  <Header />
  <div class="wrapper">
    <h1>{title}</h1>
    <h2
      class="mx-auto mt-3xs text-step-2 font-bold font-mono tracking-snug [color:color-mix(in_srgb,var(--color-surface-auxiliary-foreground-color)_65%,transparent)]"
    >
      Natural beauty routine tips
    </h2>
  </div>
</div>
