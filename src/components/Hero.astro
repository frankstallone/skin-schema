---
interface Props {
  heading?: string;
  subHeading?: string;
}

const { heading, subHeading } = Astro.props;
---

<div class="wrapper relative overflow-clip" style="--gutter: 0px;">
  <video
    loop
    muted
    playsinline
    preload="metadata"
    class="min-w-zero max-w-full"
    data-legacy-hero-video
  >
    <source src="/media/skin-schema-hero.webm" type="video/webm" />
    <source src="/media/skin-schema-hero.mp4" type="video/mp4" />
  </video>
  <div
    class="wrapper region z-20 absolute left-[0px] bottom-[10px] w-full h-full bg-surface-secondary-background-color/50 text-surface-secondary-foreground-color flow"
    data-mode="dark"
    style="--gutter: var(--spacing-s-l);"
  >
    <h1
      class="text-step-1 md:text-step-5 mt-zero tracking-tight text-balance font-mono"
      style="max-inline-size: 18ch;"
    >
      {
        heading
          ? heading
          : 'Premium beauty content that feels polished, authentic, and brand-ready'
      }
    </h1>
    <a href="/#Contact" class="button secondary mx-auto"> Reach out </a>
    {
      subHeading && (
        <h2
          class="tracking-tight text-balance text-step-2"
          style="max-inline-size: 18ch;"
        >
          {subHeading}
        </h2>
      )
    }
  </div>
</div>

<script>
  import {
    getReducedMotionSnapshot,
    subscribeToReducedMotion,
  } from '../lib/motion-preference';

  const videos = document.querySelectorAll<HTMLVideoElement>(
    '[data-legacy-hero-video]:not([data-video-motion-bound])',
  );

  videos.forEach((video) => {
    video.dataset.videoMotionBound = 'true';

    const syncPlayback = () => {
      if (getReducedMotionSnapshot()) {
        video.pause();
        return;
      }

      video.muted = true;
      video.play().catch(() => {
        // Browser playback policies can still decline; the static frame remains.
      });
    };
    const unsubscribe = subscribeToReducedMotion(syncPlayback);
    const cleanup = () => {
      unsubscribe();
      video.pause();
      delete video.dataset.videoMotionBound;
    };

    syncPlayback();
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  });
</script>
