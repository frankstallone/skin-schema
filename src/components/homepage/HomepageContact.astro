---
import { homepageKicker, homepagePrimaryAction } from './classes';

const { pathname } = Astro.props;
---

<section class="homepage-contact" id="Contact" data-section-reveal="return">
  <div class="homepage-contact__intro">
    <p class={homepageKicker}>Let's connect</p>
    <h2>
      If this approach fits your product, I would love to hear what you are
      building.
    </h2>
    <p>
      Share a few details about the product, launch, timeline, and where the
      content needs to live. I will reply within 24 hours so we can shape the
      right story and scope together.
    </p>
    <div class="homepage-contact__larger-project">
      <h3>Planning something larger?</h3>
      <p>
        Briefs that need several formats, a broader creative concept, or a more
        involved production are shaped around the launch and quoted separately.
      </p>
    </div>
  </div>
  <form
    name="homepage-contact"
    netlify-honeypot="bot-field"
    method="POST"
    data-netlify="true"
    action="/thank-you/"
    class="homepage-contact__form"
  >
    <div class="hidden">
      <input type="hidden" name="form-name" value="homepage-contact" />
      <input
        type="hidden"
        name="subject"
        value={`Form submission: skinschema.com${pathname}`}
      />
      <span>
        <label for="homepage-bot-field">Do you like delicious treats?</label>
        <input name="bot-field" id="homepage-bot-field" />
      </span>
    </div>
    <div class="homepage-contact__fields">
      <fieldset class="homepage-contact__scope" id="homepage-project-scope">
        <legend>Project type</legend>
        <div>
          <label>
            <input
              id="homepage-project-starting"
              name="project-scope"
              type="radio"
              value="starting-package"
              required
            />
            <span>Starting package</span>
          </label>
          <label>
            <input
              id="homepage-project-larger"
              name="project-scope"
              type="radio"
              value="larger-project"
              required
            />
            <span>Larger campaign or production</span>
          </label>
        </div>
      </fieldset>
      <span>
        <label for="homepage-name">Name</label>
        <input
          id="homepage-name"
          name="name"
          type="text"
          autocomplete="name"
          required
        />
      </span>
      <span>
        <label for="homepage-email">Email</label>
        <input
          id="homepage-email"
          name="email"
          type="email"
          autocomplete="email"
          required
        />
      </span>
      <span class="homepage-contact__message">
        <label for="homepage-message">What would you like to create?</label>
        <textarea name="message" id="homepage-message" rows="5" required
        ></textarea>
      </span>
    </div>
    <button type="submit" class={`${homepagePrimaryAction} border-0`}>
      Send project details
    </button>
  </form>
</section>

<script>
  const projectScopeActions = document.querySelectorAll<HTMLElement>(
    '[data-project-scope]',
  );

  projectScopeActions.forEach((action) => {
    action.addEventListener('click', () => {
      const value = action.dataset.projectScope;
      const input = document.querySelector<HTMLInputElement>(
        `input[name="project-scope"][value="${value}"]`,
      );

      if (input) input.checked = true;
    });
  });
</script>
