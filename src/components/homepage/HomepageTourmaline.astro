---
import { Picture } from 'astro:assets';
import tourmaline from '../../assets/nature/watermelon-tourmaline.png';

const imageWidths = [320, 480, 720, 960, tourmaline.width];
const imageSizes = '(max-width: 700px) 78vw, (max-width: 1100px) 44vw, 42rem';
---

<homepage-tourmaline aria-hidden="true">
  <div class="homepage-tourmaline__plane">
    <div class="homepage-tourmaline__media">
      <Picture
        class="homepage-tourmaline__shadow"
        src={tourmaline}
        alt=""
        widths={imageWidths}
        sizes={imageSizes}
        format="avif"
        quality={88}
        loading="lazy"
        decoding="async"
        draggable="false"
      />
      <Picture
        class="homepage-tourmaline__image"
        src={tourmaline}
        alt=""
        widths={imageWidths}
        sizes={imageSizes}
        format="avif"
        quality={88}
        loading="lazy"
        decoding="async"
        draggable="false"
      />
      <Picture
        class="homepage-tourmaline__relief"
        src={tourmaline}
        alt=""
        widths={imageWidths}
        sizes={imageSizes}
        format="avif"
        quality={88}
        loading="lazy"
        decoding="async"
        draggable="false"
      />
    </div>
  </div>
</homepage-tourmaline>

<style>
  homepage-tourmaline {
    --tourmaline-light-opacity: 0.18;
    --tourmaline-light-x: 58%;
    --tourmaline-light-y: 34%;
    --tourmaline-rotate-x: 0deg;
    --tourmaline-rotate-y: 0deg;
    --tourmaline-shift-x: 0px;
    --tourmaline-shift-y: 0px;
    block-size: 100%;
    contain: layout style paint;
    display: block;
    inline-size: 100%;
    opacity: 0;
    perspective: 1000px;
    position: relative;
    touch-action: pan-y;
    transition: opacity 700ms cubic-bezier(0.19, 1, 0.22, 1);
    user-select: none;
  }

  homepage-tourmaline[data-ready] {
    opacity: 1;
  }

  .homepage-tourmaline__plane {
    block-size: 100%;
    display: grid;
    inline-size: 100%;
    place-items: center;
    position: relative;
    transform: perspective(1100px)
      translate3d(var(--tourmaline-shift-x), var(--tourmaline-shift-y), 0)
      rotateX(var(--tourmaline-rotate-x)) rotateY(var(--tourmaline-rotate-y));
    transform-style: preserve-3d;
    will-change: transform;
  }

  .homepage-tourmaline__media {
    animation: homepage-tourmaline-drift 8s cubic-bezier(0.645, 0.045, 0.355, 1)
      infinite alternate;
    inline-size: min(92%, 42rem);
    position: relative;
    transform: translateZ(32px);
    transform-style: preserve-3d;
  }

  .homepage-tourmaline__image,
  .homepage-tourmaline__shadow,
  .homepage-tourmaline__relief {
    block-size: auto;
    display: block;
    inline-size: 100%;
    pointer-events: none;
  }

  .homepage-tourmaline__image {
    filter: drop-shadow(0 2rem 3rem rgb(0 0 0 / 0.22));
    position: relative;
    transform: translateZ(18px);
    z-index: 2;
  }

  .homepage-tourmaline__shadow,
  .homepage-tourmaline__relief {
    inset: 0;
    position: absolute;
  }

  .homepage-tourmaline__shadow {
    filter: blur(26px) brightness(0.35) saturate(1.25);
    opacity: 0.26;
    transform: translate3d(2%, 6%, -22px) scale(0.94);
    z-index: 0;
  }

  .homepage-tourmaline__relief {
    filter: brightness(2.05) contrast(1.75) saturate(0.72);
    -webkit-mask-image: radial-gradient(
      ellipse 46% 54% at var(--tourmaline-light-x) var(--tourmaline-light-y),
      black 0%,
      rgb(0 0 0 / 0.92) 18%,
      transparent 68%
    );
    mask-image: radial-gradient(
      ellipse 46% 54% at var(--tourmaline-light-x) var(--tourmaline-light-y),
      black 0%,
      rgb(0 0 0 / 0.92) 18%,
      transparent 68%
    );
    mix-blend-mode: screen;
    opacity: var(--tourmaline-light-opacity);
    transform: translateZ(30px);
    will-change: opacity;
    z-index: 3;
  }

  homepage-tourmaline[data-paused] .homepage-tourmaline__media {
    animation-play-state: paused;
  }

  @keyframes homepage-tourmaline-drift {
    from {
      transform: translate3d(-0.35%, 0.45%, 32px) rotateZ(-0.28deg);
    }
    to {
      transform: translate3d(0.45%, -0.35%, 32px) rotateZ(0.32deg);
    }
  }

  @media (min-width: 701px) and (max-width: 1100px) {
    .homepage-tourmaline__media {
      inline-size: min(96%, 30rem);
    }
  }

  @media (max-width: 700px) {
    .homepage-tourmaline__media {
      inline-size: min(78%, 18rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    homepage-tourmaline {
      transition: none;
    }

    .homepage-tourmaline__media {
      animation: none;
    }
  }
</style>

<script>
  const clamp = (value: number, min = 0, max = 1) =>
    Math.min(max, Math.max(min, value));

  const lerp = (from: number, to: number, amount: number) =>
    from + (to - from) * amount;

  class HomepageTourmaline extends HTMLElement {
    #abortController?: AbortController;
    #frameId = 0;
    #motionQuery?: MediaQueryList;
    #observer?: IntersectionObserver;
    #pointerX = 0;
    #pointerY = 0;
    #targetX = 0;
    #targetY = 0;
    #visible = false;

    connectedCallback() {
      this.#abortController = new AbortController();
      const { signal } = this.#abortController;
      this.#motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

      this.addEventListener(
        'pointermove',
        (event) => {
          const bounds = this.getBoundingClientRect();
          this.#targetX =
            clamp((event.clientX - bounds.left) / bounds.width) * 2 - 1;
          this.#targetY =
            clamp((event.clientY - bounds.top) / bounds.height) * 2 - 1;
        },
        { signal },
      );
      this.addEventListener(
        'pointerleave',
        () => {
          this.#targetX = 0;
          this.#targetY = 0;
        },
        { signal },
      );

      this.#observer = new IntersectionObserver(
        ([entry]) => {
          this.#visible = entry.isIntersecting;
          this.toggleAttribute('data-paused', !entry.isIntersecting);
          if (entry.isIntersecting) this.#startAnimation();
          else this.#stopAnimation();
        },
        { rootMargin: '160px' },
      );
      this.#observer.observe(this);

      document.addEventListener(
        'visibilitychange',
        () => {
          if (document.hidden) this.#stopAnimation();
          else this.#startAnimation();
        },
        { signal },
      );

      const images = [...this.querySelectorAll<HTMLImageElement>('img')];
      const reveal = async () => {
        await Promise.all(
          images.map(async (image) => {
            if (!image.complete) {
              await new Promise<void>((resolve) => {
                image.addEventListener('load', () => resolve(), { once: true });
                image.addEventListener('error', () => resolve(), {
                  once: true,
                });
              });
            }
            await image.decode?.().catch(() => undefined);
          }),
        );
        if (this.isConnected) this.setAttribute('data-ready', '');
      };
      void reveal();
    }

    disconnectedCallback() {
      this.#abortController?.abort();
      this.#observer?.disconnect();
      this.#stopAnimation();
    }

    #startAnimation = () => {
      if (this.#frameId || !this.#visible || document.hidden) return;
      this.#frameId = requestAnimationFrame(this.#update);
    };

    #stopAnimation = () => {
      cancelAnimationFrame(this.#frameId);
      this.#frameId = 0;
    };

    #update = () => {
      this.#frameId = 0;
      if (this.#visible && !document.hidden) {
        const motion = !this.#motionQuery?.matches;
        this.#pointerX = lerp(this.#pointerX, this.#targetX, 0.085);
        this.#pointerY = lerp(this.#pointerY, this.#targetY, 0.085);

        const x = motion ? this.#pointerX : 0;
        const y = motion ? this.#pointerY : 0;
        this.style.setProperty('--tourmaline-rotate-x', `${-y * 2.4}deg`);
        this.style.setProperty('--tourmaline-rotate-y', `${x * 3.2}deg`);
        this.style.setProperty('--tourmaline-shift-x', `${x * 9}px`);
        this.style.setProperty('--tourmaline-shift-y', `${y * 7}px`);
        this.style.setProperty('--tourmaline-light-x', `${56 + x * 20}%`);
        this.style.setProperty('--tourmaline-light-y', `${32 + y * 16}%`);
        this.style.setProperty(
          '--tourmaline-light-opacity',
          String(0.14 + Math.hypot(x, y) * 0.08),
        );
        this.#frameId = requestAnimationFrame(this.#update);
      }
    };
  }

  if (!customElements.get('homepage-tourmaline')) {
    customElements.define('homepage-tourmaline', HomepageTourmaline);
  }
</script>
