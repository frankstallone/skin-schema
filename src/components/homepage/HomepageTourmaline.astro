---
import { Picture } from 'astro:assets';
import tourmaline from '../../assets/nature/watermelon-tourmaline.png';

const imageWidths = [320, 480, 720, 960, tourmaline.width];
const imageSizes = '(max-width: 700px) 78vw, (max-width: 1100px) 44vw, 42rem';
---

<homepage-tourmaline aria-hidden="true">
  <div class="homepage-tourmaline__plane">
    <div class="homepage-tourmaline__media">
      <Picture
        class="homepage-tourmaline__shadow"
        src={tourmaline}
        alt=""
        widths={imageWidths}
        sizes={imageSizes}
        format="avif"
        quality={88}
        loading="lazy"
        decoding="async"
        draggable="false"
      />
      <Picture
        class="homepage-tourmaline__image"
        src={tourmaline}
        alt=""
        widths={imageWidths}
        sizes={imageSizes}
        format="avif"
        quality={88}
        loading="lazy"
        decoding="async"
        draggable="false"
      />
      <Picture
        class="homepage-tourmaline__relief"
        src={tourmaline}
        alt=""
        widths={imageWidths}
        sizes={imageSizes}
        format="avif"
        quality={88}
        loading="lazy"
        decoding="async"
        draggable="false"
      />
    </div>
  </div>
</homepage-tourmaline>

<style>
  @property --tourmaline-light-x {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 56%;
  }

  @property --tourmaline-light-y {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 32%;
  }

  homepage-tourmaline {
    block-size: 100%;
    contain: layout style paint;
    display: block;
    inline-size: 100%;
    opacity: 0;
    perspective: 1000px;
    position: relative;
    touch-action: pan-y;
    transition: opacity 700ms cubic-bezier(0.19, 1, 0.22, 1);
    user-select: none;
  }

  homepage-tourmaline[data-ready] {
    opacity: 1;
  }

  .homepage-tourmaline__plane {
    block-size: 100%;
    display: grid;
    inline-size: 100%;
    place-items: center;
    position: relative;
    transform: perspective(1100px) translate3d(0, 0, 0) rotateX(0deg)
      rotateY(0deg);
    transform-style: preserve-3d;
    will-change: transform;
  }

  .homepage-tourmaline__media {
    animation: homepage-tourmaline-drift 8s cubic-bezier(0.645, 0.045, 0.355, 1)
      infinite alternate;
    inline-size: min(92%, 42rem);
    position: relative;
    transform: translateZ(32px);
    transform-style: preserve-3d;
  }

  .homepage-tourmaline__image,
  .homepage-tourmaline__shadow,
  .homepage-tourmaline__relief {
    block-size: auto;
    display: block;
    inline-size: 100%;
    pointer-events: none;
  }

  .homepage-tourmaline__image {
    filter: drop-shadow(0 2rem 3rem rgb(0 0 0 / 0.22));
    position: relative;
    transform: translateZ(18px);
    z-index: 2;
  }

  .homepage-tourmaline__shadow,
  .homepage-tourmaline__relief {
    inset: 0;
    position: absolute;
  }

  .homepage-tourmaline__shadow {
    filter: blur(26px) brightness(0.35) saturate(1.25);
    opacity: 0.26;
    transform: translate3d(2%, 6%, -22px) scale(0.94);
    z-index: 0;
  }

  .homepage-tourmaline__relief {
    --tourmaline-light-x: 56%;
    --tourmaline-light-y: 32%;
    filter: brightness(2.05) contrast(1.75) saturate(0.72);
    -webkit-mask-image: radial-gradient(
      ellipse 46% 54% at var(--tourmaline-light-x) var(--tourmaline-light-y),
      black 0%,
      rgb(0 0 0 / 0.92) 18%,
      transparent 68%
    );
    mask-image: radial-gradient(
      ellipse 46% 54% at var(--tourmaline-light-x) var(--tourmaline-light-y),
      black 0%,
      rgb(0 0 0 / 0.92) 18%,
      transparent 68%
    );
    mix-blend-mode: screen;
    opacity: 0.14;
    transform: translateZ(30px);
    will-change: opacity;
    z-index: 3;
  }

  homepage-tourmaline[data-paused] .homepage-tourmaline__media {
    animation-play-state: paused;
  }

  @keyframes homepage-tourmaline-drift {
    from {
      transform: translate3d(-0.35%, 0.45%, 32px) rotateZ(-0.28deg);
    }
    to {
      transform: translate3d(0.45%, -0.35%, 32px) rotateZ(0.32deg);
    }
  }

  @media (min-width: 701px) and (max-width: 1100px) {
    .homepage-tourmaline__media {
      inline-size: min(96%, 30rem);
    }
  }

  @media (max-width: 700px) {
    .homepage-tourmaline__media {
      inline-size: min(78%, 18rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    homepage-tourmaline {
      transition: none;
    }

    .homepage-tourmaline__media {
      animation: none;
    }
  }
</style>

<script>
  const clamp = (value: number, min = 0, max = 1) =>
    Math.min(max, Math.max(min, value));

  const lerp = (from: number, to: number, amount: number) =>
    from + (to - from) * amount;

  class HomepageTourmaline extends HTMLElement {
    #abortController?: AbortController;
    #frameId = 0;
    #motionQuery?: MediaQueryList;
    #observer?: IntersectionObserver;
    #plane?: HTMLElement;
    #pointerAbortController?: AbortController;
    #pointerQuery?: MediaQueryList;
    #pointerX = 0;
    #pointerY = 0;
    #relief?: HTMLElement;
    #targetX = 0;
    #targetY = 0;
    #visible = false;

    connectedCallback() {
      const abortController = new AbortController();
      this.#abortController = abortController;
      const { signal } = abortController;
      this.#plane =
        this.querySelector<HTMLElement>('.homepage-tourmaline__plane') ??
        undefined;
      this.#relief =
        this.querySelector<HTMLElement>('.homepage-tourmaline__relief') ??
        undefined;
      this.#motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.#pointerQuery = window.matchMedia(
        '(hover: hover) and (pointer: fine)',
      );
      this.#visible = false;
      this.#resetToNeutral();
      this.#syncPausedState();

      this.#motionQuery.addEventListener('change', this.#handleMotionChange, {
        signal,
      });
      this.#pointerQuery.addEventListener(
        'change',
        this.#handlePointerCapabilityChange,
        { signal },
      );
      this.#syncPointerListeners();

      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!this.isConnected || this.#observer !== observer) return;
          this.#visible = entry.isIntersecting;
          this.#syncPausedState();
          if (entry.isIntersecting) this.#wakeAnimation();
          else this.#stopAnimation();
        },
        { rootMargin: '160px' },
      );
      this.#observer = observer;
      observer.observe(this);

      document.addEventListener(
        'visibilitychange',
        () => {
          this.#syncPausedState();
          if (document.hidden) this.#stopAnimation();
          else this.#wakeAnimation();
        },
        { signal },
      );

      const images = [...this.querySelectorAll<HTMLImageElement>('img')];
      const reveal = async () => {
        await Promise.all(
          images.map(async (image) => {
            if (!image.complete) {
              await new Promise<void>((resolve) => {
                const finish = () => {
                  image.removeEventListener('load', finish);
                  image.removeEventListener('error', finish);
                  signal.removeEventListener('abort', finish);
                  resolve();
                };
                image.addEventListener('load', finish, { once: true });
                image.addEventListener('error', finish, { once: true });
                signal.addEventListener('abort', finish, { once: true });
              });
            }
            if (signal.aborted) return;
            await image.decode?.().catch(() => undefined);
          }),
        );
        if (
          this.isConnected &&
          !signal.aborted &&
          this.#abortController === abortController
        ) {
          this.setAttribute('data-ready', '');
        }
      };
      void reveal();
    }

    disconnectedCallback() {
      this.#pointerAbortController?.abort();
      this.#pointerAbortController = undefined;
      this.#abortController?.abort();
      this.#abortController = undefined;
      this.#observer?.disconnect();
      this.#observer = undefined;
      this.#visible = false;
      this.#resetToNeutral();
      this.#motionQuery = undefined;
      this.#pointerQuery = undefined;
      this.#plane = undefined;
      this.#relief = undefined;
    }

    #canAnimate = () =>
      this.isConnected &&
      this.#visible &&
      !document.hidden &&
      !this.#motionQuery?.matches &&
      Boolean(this.#pointerQuery?.matches);

    #handleMotionChange = () => {
      this.#syncPointerListeners();
      if (this.#motionQuery?.matches) this.#resetToNeutral();
      else this.#wakeAnimation();
    };

    #handlePointerCapabilityChange = () => {
      this.#syncPointerListeners();
      if (!this.#pointerQuery?.matches) this.#resetToNeutral();
      else this.#wakeAnimation();
    };

    #setTarget = (x: number, y: number) => {
      if (x === this.#targetX && y === this.#targetY) return;
      this.#targetX = x;
      this.#targetY = y;

      if (this.#isSettled()) {
        this.#pointerX = this.#targetX;
        this.#pointerY = this.#targetY;
        this.#render(this.#pointerX, this.#pointerY);
        return;
      }

      this.#wakeAnimation();
    };

    #syncPointerListeners = () => {
      this.#pointerAbortController?.abort();
      this.#pointerAbortController = undefined;
      if (
        !this.isConnected ||
        !this.#pointerQuery?.matches ||
        this.#motionQuery?.matches
      ) {
        return;
      }

      this.#pointerAbortController = new AbortController();
      const { signal } = this.#pointerAbortController;
      this.addEventListener(
        'pointermove',
        (event) => {
          const bounds = this.getBoundingClientRect();
          if (bounds.width <= 0 || bounds.height <= 0) return;
          this.#setTarget(
            clamp((event.clientX - bounds.left) / bounds.width) * 2 - 1,
            clamp((event.clientY - bounds.top) / bounds.height) * 2 - 1,
          );
        },
        { signal },
      );
      this.addEventListener('pointerleave', () => this.#setTarget(0, 0), {
        signal,
      });
    };

    #syncPausedState = () => {
      this.toggleAttribute('data-paused', !this.#visible || document.hidden);
    };

    #isSettled = () =>
      Math.abs(this.#targetX - this.#pointerX) <= 0.001 &&
      Math.abs(this.#targetY - this.#pointerY) <= 0.001;

    #wakeAnimation = () => {
      if (this.#frameId || !this.#canAnimate() || this.#isSettled()) return;
      this.#frameId = requestAnimationFrame(this.#update);
    };

    #stopAnimation = () => {
      cancelAnimationFrame(this.#frameId);
      this.#frameId = 0;
    };

    #resetToNeutral = () => {
      this.#stopAnimation();
      this.#pointerX = 0;
      this.#pointerY = 0;
      this.#targetX = 0;
      this.#targetY = 0;
      this.#render(0, 0);
    };

    #render = (x: number, y: number) => {
      if (this.#plane) {
        this.#plane.style.transform =
          `perspective(1100px) translate3d(${x * 9}px, ${y * 7}px, 0) ` +
          `rotateX(${-y * 2.4}deg) rotateY(${x * 3.2}deg)`;
      }
      if (this.#relief) {
        this.#relief.style.setProperty(
          '--tourmaline-light-x',
          `${56 + x * 20}%`,
        );
        this.#relief.style.setProperty(
          '--tourmaline-light-y',
          `${32 + y * 16}%`,
        );
        this.#relief.style.opacity = String(0.14 + Math.hypot(x, y) * 0.08);
      }
    };

    #update = () => {
      this.#frameId = 0;
      if (!this.#canAnimate()) return;

      this.#pointerX = lerp(this.#pointerX, this.#targetX, 0.085);
      this.#pointerY = lerp(this.#pointerY, this.#targetY, 0.085);

      if (this.#isSettled()) {
        this.#pointerX = this.#targetX;
        this.#pointerY = this.#targetY;
      }

      this.#render(this.#pointerX, this.#pointerY);
      this.#wakeAnimation();
    };
  }

  if (!customElements.get('homepage-tourmaline')) {
    customElements.define('homepage-tourmaline', HomepageTourmaline);
  }
</script>
