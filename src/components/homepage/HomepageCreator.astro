---
import { Picture } from 'astro:assets';
import { creatorImages, proofPoints } from './data';
import { homepageKicker } from './classes';
---

<section
  class="homepage-creator"
  aria-labelledby="homepage-creator-title"
  data-section-reveal="story"
>
  <div class="homepage-creator__portrait">
    <Picture
      src={creatorImages.portrait}
      alt="Photograph of Kseniya, the creator behind Skin Schema"
      class="homepage-creator__primary-image"
      widths={[320, 640, creatorImages.portrait.width]}
      sizes="(max-width: 900px) 68vw, 34vw"
      quality={80}
      format="avif"
    />
    <Picture
      src={creatorImages.campaignStill}
      alt="Beauty campaign still by Skin Schema"
      class="homepage-creator__supporting-image"
      widths={[180, 360, 640]}
      sizes="(max-width: 900px) 28vw, 1px"
      quality={80}
      format="avif"
    />
  </div>
  <div class="homepage-creator__copy">
    <p class={homepageKicker}>Meet Kseniya</p>
    <h2 id="homepage-creator-title">
      An honest belief about the role beauty can play.
    </h2>
    <p>
      Skin Schema grew from my own experience of beauty routines as a way to
      slow down, return to the senses, and practice care. The product did not
      create that change. It gave the pause a physical form.
    </p>
    <p>
      As a beauty photographer and videographer, I have worked across more than
      30 brands and more than 50 campaigns. I now create stories grounded in
      what each product genuinely does and the moments of care it can become
      part of.
    </p>
    <ul role="list">
      {
        proofPoints.map((point) => (
          <li>
            <strong>{point.title}</strong>
            <p>{point.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
