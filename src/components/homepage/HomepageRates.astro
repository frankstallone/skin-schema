---
import { startingRates } from './data';
import { homepagePrimaryAction } from './classes';

const rates = startingRates.map((rate, index) => ({
  ...rate,
  outcome:
    index === 0
      ? 'A focused set of stills for product detail, texture, and use.'
      : index === 1
        ? 'A short film for texture, application, or a beauty routine.'
        : 'A developed film that connects real product qualities with a moment of care.',
  bestFor:
    index === 0
      ? 'Product pages and launches'
      : index === 1
        ? 'Social stories and routines'
        : 'Fuller product stories',
}));
---

<section class="homepage-rates" id="Rates" aria-labelledby="rates-title">
  <div class="rates-ladder__aside">
    <h2 id="rates-title">Start with the format that fits your story.</h2>
    <p>
      Tell us where the content needs to live and what you want the audience to
      notice. We will shape the idea, deliverables, usage, and review process
      around that.
    </p>
    <a href="#Contact" class={homepagePrimaryAction}>Discuss your project</a>
  </div>
  <ol class="rates-ladder" aria-label="Starting rate progression">
    {
      rates.map((rate) => (
        <li>
          <div class="rates-ladder__item">
            <div class="rates-ladder__copy">
              <p>{rate.bestFor}</p>
              <h3>{rate.title}</h3>
              <span>{rate.outcome}</span>
            </div>
            <dl>
              {rate.specs.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
            <div class="rates-ladder__price">
              <span>Starts at</span>
              <strong>{rate.price}</strong>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>
