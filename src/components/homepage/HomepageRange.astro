---
import { Picture } from 'astro:assets';
import { rangeExamples } from './data';
import { homepageKicker } from './classes';
import HomepageRangeCarousel from './HomepageRangeCarousel';

const rangeColumnTemplate = rangeExamples
  .map((example) => `minmax(0, ${example.columnWeight}fr)`)
  .join(' ');

const carouselSections = rangeExamples.map((example) => ({
  id: example.id,
  label: example.label,
  title: example.carouselTitle,
  media: example.carouselMedia.map((media) => {
    if (media.kind === 'image') {
      return {
        kind: media.kind,
        src: media.src.src,
        alt: media.alt,
        width: media.src.width,
        height: media.src.height,
      };
    }

    return {
      kind: media.kind,
      src: media.src,
      alt: media.alt,
    };
  }),
}));
---

<section
  class="homepage-range"
  aria-labelledby="homepage-range-title"
  data-homepage-range
  data-section-reveal="showcase"
>
  <div class="homepage-range__intro">
    <div>
      <p class={homepageKicker}>Content range</p>
      <h2 id="homepage-range-title">
        Photo sets, short videos, and product story films.
      </h2>
    </div>
    <p>
      Choose a single format or build a connected suite around one clear idea.
    </p>
  </div>
  <div
    class="homepage-range__grid"
    style={`--homepage-range-columns: ${rangeColumnTemplate};`}
  >
    {
      rangeExamples.map((example) => (
        <button
          type="button"
          class={`homepage-range__item homepage-range__item--${example.kind}`}
          style={`--homepage-range-aspect-ratio: ${example.aspectRatio}; --homepage-range-object-position: ${example.objectPosition}; --homepage-range-media-transform: ${example.mediaTransform};`}
          data-range-carousel-trigger={example.id}
          aria-label={`Open ${example.label} carousel`}
          aria-haspopup="dialog"
        >
          {example.kind === 'image' ? (
            <Picture
              src={example.src as ImageMetadata}
              alt={example.alt}
              format="avif"
              quality={80}
            />
          ) : (
            <video
              data-range-preview-video
              loop
              muted
              playsinline
              preload="metadata"
              aria-label={example.alt}
            >
              <source src={example.src} type="video/mp4" />
            </video>
          )}
          <span class="homepage-range__caption" aria-hidden="true">
            <span>{example.label}</span>
          </span>
        </button>
      ))
    }
  </div>
  <HomepageRangeCarousel client:load sections={carouselSections} />
</section>

<script>
  import {
    getReducedMotionSnapshot,
    subscribeToReducedMotion,
  } from '../../lib/motion-preference';

  const ranges = document.querySelectorAll<HTMLElement>(
    '[data-homepage-range]:not([data-video-motion-bound])',
  );

  ranges.forEach((range) => {
    range.dataset.videoMotionBound = 'true';

    const videos = range.querySelectorAll<HTMLVideoElement>(
      '[data-range-preview-video]',
    );
    const syncPlayback = () => {
      videos.forEach((video) => {
        if (getReducedMotionSnapshot()) {
          video.pause();
          return;
        }

        video.muted = true;
        video.play().catch(() => {
          // Browser playback policies can still decline; the static frame remains.
        });
      });
    };
    const unsubscribe = subscribeToReducedMotion(syncPlayback);
    const cleanup = () => {
      unsubscribe();
      videos.forEach((video) => video.pause());
      delete range.dataset.videoMotionBound;
    };

    syncPlayback();
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  });
</script>
