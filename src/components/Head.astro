---
import '../css/global.css';
interface Props {
  title?: string;
  description?: string;
  canonicalURL?: URL | string;
  image?: string;
  imageAlt?: string;
  themeColor?: string;
  statusBarStyle?: 'default' | 'black' | 'black-translucent';
}

const {
  title,
  description,
  canonicalURL,
  image,
  imageAlt = 'Skin Schema premium beauty content for skincare brands',
  themeColor = '#ffffff',
  statusBarStyle = 'default',
} = Astro.props;

const metaDescription =
  description ||
  'Committed to uncovering the best in authentic, minimalistic beauty. Tips, routines, and product reviews for a serene self-care experience.';
const siteUrl = new URL('/', Astro.site || Astro.url);
const usesDefaultImage = !image;
const ogImage = image || '/media/og-image-2026-08.jpg';
const ogImageUrl = new URL(ogImage, siteUrl).toString();

// If canonicalURL is not provided, use the current URL
const canonicalUrl = new URL(canonicalURL || Astro.url, siteUrl);
const canonical = canonicalUrl.toString();
const isHomepage = canonicalUrl.pathname === '/';
const websiteId = new URL('#website', siteUrl).toString();
const organizationId = new URL('#organization', siteUrl).toString();
const structuredData = isHomepage
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': websiteId,
          url: siteUrl.toString(),
          name: 'Skin Schema',
          publisher: { '@id': organizationId },
        },
        {
          '@type': 'Organization',
          '@id': organizationId,
          name: 'Skin Schema',
          url: siteUrl.toString(),
          description: metaDescription,
          logo: {
            '@type': 'ImageObject',
            url: new URL('/web-app-manifest-512x512.png', siteUrl).toString(),
            width: 512,
            height: 512,
          },
          sameAs: ['https://www.instagram.com/skinschema/'],
        },
      ],
    }
  : undefined;
---

<head>
  <meta charset="UTF-8" />
  <meta name="description" content={metaDescription} />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  />
  <meta name="theme-color" content={themeColor} />
  <meta name="apple-mobile-web-app-status-bar-style" content={statusBarStyle} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="describedby" href="/llms.txt" />

  <!-- Canonical -->
  <link rel="canonical" href={canonical} />
  <meta name="generator" content={Astro.generator} />

  <!-- Open Graph -->
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="Skin Schema" />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={ogImageUrl} />
  {usesDefaultImage && <meta property="og:image:type" content="image/jpeg" />}
  {usesDefaultImage && <meta property="og:image:width" content="1200" />}
  {usesDefaultImage && <meta property="og:image:height" content="630" />}
  <meta property="og:image:alt" content={imageAlt} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={imageAlt} />

  {
    structuredData && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(structuredData)}
      />
    )
  }
  <meta name="title" content={title} />

  <!-- Google tag (gtag.js) -->
  <script
    type="text/partytown"
    is:inline
    async
    src="https://www.googletagmanager.com/gtag/js?id=G-R4BV0D0EME"></script>
  <script type="text/partytown" is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('js', new Date());

    gtag('config', 'G-R4BV0D0EME');
  </script>
</head>
