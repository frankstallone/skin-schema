---
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
const {
  meta,
  hideFooter = false,
  designContract,
  mode = 'light',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-mode={mode}>
  <Head {...meta} />
  <body>
    {
      designContract && (
        <Fragment set:html={`<!-- Design contract: ${designContract} -->`} />
      )
    }
    <a href="#main" class="sr-only sr-only-focusable">Skip to content</a>
    <slot />
    {!hideFooter && <Footer />}
  </body>
</html>
