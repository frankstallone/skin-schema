# Server-only Stripe TEST secret or restricted key. Live keys are rejected.
STRIPE_SECRET_KEY=

# Exactly one Stripe test Price and private R2 ZIP object for each catalog bundle.
# Replace each price placeholder with its matching Stripe test Dashboard Price ID.
STOREFRONT_PRODUCTS_JSON='{"bathroom-rituals":{"stripePriceId":"price_replace_bathroom","objectKey":"storefront/bathroom-rituals.zip"},"coastal-skin":{"stripePriceId":"price_replace_coastal","objectKey":"storefront/coastal-skin.zip"}}'

# Shared private Cloudflare R2 bucket credentials. Keep public access disabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
