{
  "name": "skin-schema",
  "type": "module",
  "version": "1.0.0",
  "author": "Frank Stallone <frank@stallone.dev>",
  "description": "Website for Skin Schema",
  "scripts": {
    "tokens:build": "node ./scripts/build-tailwind-theme.mjs",
    "tokens:test": "node --test src/css-utils/__tests__/tailwind-token-generator.test.js",
    "test": "tsx --test src/css-utils/__tests__/*.test.js src/lib/storefront/**/*.test.ts",
    "dev": "npm run tokens:build && astro dev",
    "start": "npm run tokens:build && astro dev",
    "lint": "npm run tokens:build && astro check",
    "build": "npm run tokens:build && astro check && astro build",
    "preview": "npm run tokens:build && astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/netlify": "^8.2.14",
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@tailwindcss/vite": "^4.3.5",
    "@zachleat/details-utils": "^2.0.2",
    "@zachleat/table-saw": "^1.1.1",
    "astro": "^7.4.13",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.80.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "slugify": "^1.6.9",
    "stripe": "^22.6.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
